# ===== vps-oneclick 配置模板 =====
# 使用方法：复制为 config.env 后再填写；真实 config.env 不提交。

# --- 主节点：VLESS + XHTTP + Reality（必装） ---
REALITY_SNI="www.samsung.com"
REALITY_PORT="443"
UUID=""

# --- 备用节点：VLESS + XHTTP + TLS，经 Cloudflare CDN（可选） ---
# 填你的域名（如 la.example.com）即启用；留空则跳过该节点。
# 前置条件：Cloudflare DNS 添加 A 记录指向服务器 IP 并开启橙色云。
CDN_DOMAIN=""
CDN_PORT="2053"
# 可选：把 Cloudflare Origin 证书放到项目目录 cert.pem / key.pem，
# 未提供时脚本会生成自签证书（CF SSL 模式用 Full 即可）。

# --- 组件开关 ---
INSTALL_SERVERSTATUS="1"   # 0 不安装；1 服务端 + 本机探针；2 仅探针客户端
INSTALL_3XUI="0"           # 3x-ui 管理面板
INSTALL_TUNNEL="1"         # cloudflared Tunnel（Zero Trust 发布面板）

# --- Cloudflare Tunnel ---
# Zero Trust 后台 -> Networks -> Tunnels -> Create tunnel，
# 选 "Cloudflared" 类型后复制 token 粘贴到这里。留空则只装客户端不接入。
TUNNEL_TOKEN=""

# --- Tunnel 公网访问地址（写入部署报告） ---
PANEL_PUBLIC_DOMAIN=""
STATUS_PUBLIC_DOMAIN=""

# --- 系统 ---
SSH_PORT="22"
# 系统时区；必须使用 IANA 时区名，格式：区域/城市
# 不要写 UTC+8 / GMT+8 / 中文时区
# 可用 timedatectl list-timezones 查询合法值
TIMEZONE="America/Los_Angeles"

# --- 以下全部留空自动生成（INSTALL_SERVERSTATUS=2 时 SS_USER / SS_PASS 必填） ---
PRIVATE_KEY=""
PUBLIC_KEY=""
SHORT_ID=""
PANEL_PORT=""
PANEL_USER=""
PANEL_PASS=""
PANEL_PATH=""
SS_USER=""
SS_PASS=""
SS_PANEL_PORT="35601"
SS_WEB_PORT="35602"

# --- 仅探针客户端模式（INSTALL_SERVERSTATUS="2"） ---
# 填已有 ServerStatus 主服务器的公网 IP / 域名；凭据用上方 SS_USER / SS_PASS。
SS_SERVER="主服务器IP"
SS_PANEL_PORT="35601"
SS_USER="主服务器分配的节点用户名"
SS_PASS="主服务器分配的节点密码"
